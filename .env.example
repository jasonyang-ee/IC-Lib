# IC Component Library - Development Environment Configuration
# Copy this file to .env and update with your actual values for local development.

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string-in-production-minimum-32-characters

# Database Configuration
DB_HOST=ip_address_or_hostname
DB_PORT=5432
DB_USER=username
DB_PASSWORD=password
DB_NAME=database_name

# Server Configuration
PORT=3500
NODE_ENV=development
VITE_API_URL=http://localhost:3500/api
CORS_ORIGIN=http://localhost:5173

# Reverse-proxy / rate limiting (SPEC V32). TRUST_PROXY_HOPS = number of proxy
# hops in front of Node. Direct Node defaults to 0; the bundled nginx image sets
# 1 so req.ip is the real client. Match this value to the actual topology.
# The rate-limit knobs are optional; sane defaults apply when unset.
#
# Three independent budgets: failed logins per client IP, failed
# change-password attempts per authenticated user id, and a coarse per-IP
# ceiling over ONLY the public read surface (V10) plus the barcode lookup.
# Exhausting one cannot lock out the others, and authenticated traffic never
# spends the shared public/NAT budget.
#
# The counters live in this process's memory: they reset on restart, and with
# more than one app process or replica each keeps its own counts. A horizontally
# scaled deployment needs a shared external store before enforcement can be
# called uniform.
# TRUST_PROXY_HOPS=0
# RATE_LIMIT_LOGIN_MAX=10                    # failed logins per IP per window
# RATE_LIMIT_LOGIN_WINDOW_MS=900000          # 15 min
# RATE_LIMIT_CHANGE_PASSWORD_MAX=10          # failed attempts per user per window
# RATE_LIMIT_CHANGE_PASSWORD_WINDOW_MS=900000
# RATE_LIMIT_GLOBAL_MAX=1000                 # public-surface requests per IP per window
# RATE_LIMIT_GLOBAL_WINDOW_MS=900000

# Config and Toggles
CONFIG_ECO=false
CONFIG_BASE_URL=http://localhost:5173
# CONFIG_SUBDIRECTORY_PATH=/iclib/
# VITE_CONFIG_ECO=false

# API Keys (Optional - for vendor integrations)
DIGIKEY_CLIENT_ID=your_digikey_client_id
DIGIKEY_CLIENT_SECRET=your_digikey_client_secret
MOUSER_API_KEY=your_mouser_api_key
# Timeout (ms) bounding every outbound vendor HTTP call (SPEC V34). A hung
# upstream aborts after this instead of stalling a bulk refresh. Default 15000.
# VENDOR_HTTP_TIMEOUT_MS=15000

# OIDC / SSO (Optional - enterprise single sign-on)
# Enabled iff OIDC_ISSUER_URL and OIDC_CLIENT_ID are both set.
# Local accounts keep working as break-glass; SSO users are JIT-provisioned
# with OIDC_DEFAULT_ROLE and elevated by an admin afterwards.
# OIDC_ALLOWED_TENANTS is an optional comma-separated tenant-ID allowlist and
# defaults to empty (no tenant-claim filter). Exact Microsoft Entra /common or
# /organizations issuers require a nonempty allowlist; tenant-specific Entra
# issuers and generic OIDC providers can leave it unset.
# OIDC_ISSUER_URL=https://idp.example.com/realms/company
# OIDC_CLIENT_ID=iclib
# OIDC_CLIENT_SECRET=your_client_secret
# OIDC_REDIRECT_URI=http://localhost:5173/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_PROVIDER_NAME=Company SSO
# OIDC_DEFAULT_ROLE=read-only
# OIDC_ALLOWED_TENANTS=00000000-0000-0000-0000-000000000000

# Entra SCIM provisioning (Optional - user lifecycle from Entra ID)
# Enabled iff BOTH variables are set; setting one, a non-GUID tenant, or a
# token shorter than 32 characters stops the server rather than serving
# provisioning behind an ambiguous credential.
# SCIM_TENANT_ID is the single Entra tenant allowed to provision, and the
# Secret Token below must be generated per deployment (never reuse this
# placeholder) and rotated by replacing it in both Entra and the environment.
# Requires SSO first: SCIM only updates users an OIDC login already created,
# and refuses to create an unknown one. See README "Entra SCIM provisioning".
# SCIM_TENANT_ID=00000000-0000-0000-0000-000000000000
# SCIM_BEARER_TOKEN=generate_a_random_secret_of_at_least_32_characters
